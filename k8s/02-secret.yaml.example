# This is documentation only. Do not rename, apply, or commit a populated copy.
#
# Create the runtime Secret without writing credentials to disk:
#   Linux/macOS: k8s/scripts/bootstrap-secrets.sh
#   PowerShell:  k8s/scripts/bootstrap-secrets.ps1
apiVersion: v1
kind: Secret
metadata:
  name: cnas-secret
  namespace: cnas
type: Opaque
stringData:
  DB_USER: replace-me
  DB_PASSWORD: replace-me
  MYSQL_ROOT_PASSWORD: replace-me
  REDIS_PASSWORD: replace-me
