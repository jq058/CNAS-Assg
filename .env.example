# Copy this file to .env and replace every placeholder before starting Compose.
# Never commit the resulting .env file.

DB_HOST=mysql
DB_NAME=mydb
DB_USER=cnasuser
DB_PASSWORD=replace-with-a-long-random-database-password
DB_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
APP_ENV=local
APP_PORT=8080

# Redis provides shared sessions across the three PHP replicas.
SESSION_HANDLER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-a-long-random-redis-password
SESSION_COOKIE_SECURE=false

# Docker registry values used by CI/CD.
DOCKER_REGISTRY=yourdockerhub
DOCKER_IMAGE_NAME=cnas-php-app
DOCKER_IMAGE_TAG=v1
